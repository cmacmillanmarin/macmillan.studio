[{"id":129,"date":"2023-09-05T11:20:12","date_gmt":"2023-09-05T11:20:12","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=129"},"modified":"2024-11-07T12:29:12","modified_gmt":"2024-11-07T12:29:12","slug":"in-house-support","status":"publish","type":"service","link":"https://ms-cms.com/service/in-house-support/","title":{"rendered":"In—house Support"},"template":"","class_list":["post-129","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">I collaborate individually, as the sole freelance partner, with studios and agencies on a project basis, building open partnerships to achieve shared goals. My approach is always flexible, adapting to your team’s schedule. I place a lot of importance on effective collaboration and keeping a positive, friendly attitude throughout the process.</p>\n<p class=\"p1\">This is especially efficient if you’re working with technologies like Nuxt/Vue, Next/React, Vanilla JS, and WebGL.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/129"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=129"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":128,"date":"2023-09-05T11:19:56","date_gmt":"2023-09-05T11:19:56","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=128"},"modified":"2024-09-27T12:04:36","modified_gmt":"2024-09-27T12:04:36","slug":"site-maintainance","status":"publish","type":"service","link":"https://ms-cms.com/service/site-maintainance/","title":{"rendered":"Site Maintainance"},"template":"","class_list":["post-128","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">We aim to build long-term relationships with our clients. We don’t just launch and forget. We offer annual packages to help you manage your site after it’s live, covering everything from updates and optimizations to security checks and protection against attacks, as well as adding new features.</p>\n<p class=\"p1\">We’ve got you covered.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/128"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=128"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":127,"date":"2023-09-05T11:19:38","date_gmt":"2023-09-05T11:19:38","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=127"},"modified":"2024-09-27T11:19:59","modified_gmt":"2024-09-27T11:19:59","slug":"web3","status":"publish","type":"service","link":"https://ms-cms.com/service/web3/","title":{"rendered":"AI &#038; Web3"},"template":"","class_list":["post-127","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">We’re actively working with AI and Web3 in current projects, constantly exploring their potential. From developing an NFT marketplace in Inkollectors to creating a virtual assistant that enhances user experience through AI, we’re excited about what these innovations can achieve and always open to exploring new possibilities with each project.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/127"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=127"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":126,"date":"2023-09-05T11:19:11","date_gmt":"2023-09-05T11:19:11","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=126"},"modified":"2024-09-27T11:59:27","modified_gmt":"2024-09-27T11:59:27","slug":"native-apps","status":"publish","type":"service","link":"https://ms-cms.com/service/native-apps/","title":{"rendered":"Web &#038; Native Apps"},"template":"","class_list":["post-126","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">We develop native apps using React Native, a framework powering thousands of apps, including familiar ones like Facebook, Skype, Outlook, and Discord. Additionally, any website can become a web app with its own icon on the home screen, thanks to Progressive Web Applications (PWA).</p>\n<p class=\"p1\">Whether you’re looking for a PWA or a fully native app, we provide tailored solutions.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/126"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=126"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":125,"date":"2023-09-05T11:18:48","date_gmt":"2023-09-05T11:18:48","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=125"},"modified":"2024-09-27T11:11:58","modified_gmt":"2024-09-27T11:11:58","slug":"webgl","status":"publish","type":"service","link":"https://ms-cms.com/service/webgl/","title":{"rendered":"WebGL"},"template":"","class_list":["post-125","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">An innovative web experience can significantly enhance your brand’s perceived value and boost conversions. We support you every step of the way, from initial concept and prototyping to implementation, ensuring your project stands out with cutting-edge technology and design.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/125"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=125"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":124,"date":"2023-09-05T11:18:28","date_gmt":"2023-09-05T11:18:28","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=124"},"modified":"2024-11-07T12:28:48","modified_gmt":"2024-11-07T12:28:48","slug":"shopify-e-commerce","status":"publish","type":"service","link":"https://ms-cms.com/service/shopify-e-commerce/","title":{"rendered":"Headless E—Commerce"},"template":"","class_list":["post-124","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">A faster site, better scalability, and more conversions. If the standard templates from platforms like Shopify or WooCommerce don’t deliver the experience your business needs, we’re here to help. We focus on improving loading times, enhancing usability, and, most importantly, creating a fully personalized experience for your customers.</p>\n<p class=\"p1\">We work with Shopify, Square, WooCommerce, and more.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/124"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=124"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":123,"date":"2023-09-05T11:18:10","date_gmt":"2023-09-05T11:18:10","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=123"},"modified":"2024-11-07T12:29:00","modified_gmt":"2024-11-07T12:29:00","slug":"back-end","status":"publish","type":"service","link":"https://ms-cms.com/service/back-end/","title":{"rendered":"Back—end"},"template":"","class_list":["post-123","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">We offer fully customizable solutions, always with a headless approach, selecting the best platform for each project. Everything is properly documented, so you and your team can work independently, saving both time and costs.</p>\n<p class=\"p1\">We work with Strapi, Contentful, Contentstack, Prismic, Storyblok, WordPress, and Shopify.</p>\n<p class=\"p1\">Please note, we do not offer back-end as a standalone service.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/123"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=123"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":122,"date":"2023-09-05T11:17:51","date_gmt":"2023-09-05T11:17:51","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=122"},"modified":"2024-11-07T12:23:18","modified_gmt":"2024-11-07T12:23:18","slug":"front-end","status":"publish","type":"service","link":"https://ms-cms.com/service/front-end/","title":{"rendered":"Front—end"},"template":"","class_list":["post-122","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">While our roots are in technology, design is just as important to us. We carefully implement designs from the ground up, with a strong focus on motion, interaction, and user experience. Our goal is to create high-performance solutions that not only work seamlessly but are also visually compelling.</p>\n<p class=\"p1\">Every detail is given careful attention to ensure a polished final result.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/122"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=122"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}]