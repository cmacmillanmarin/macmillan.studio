[{"id":980,"date":"2026-08-08T09:30:53","date_gmt":"2026-08-08T09:30:53","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=980"},"modified":"2026-08-10T09:33:37","modified_gmt":"2026-08-10T09:33:37","slug":"installation","status":"publish","type":"service","link":"https://ms-cms.com/service/installation/","title":{"rendered":"Installations"},"template":"","class_list":["post-980","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">Interactive installations for physical spaces, combining creative technology with reliable software. From touch displays and large-scale screens to custom hardware integrations, delivering experiences that go beyond the browser.</p>\n<p class=\"p3\">Built for museums, exhibitions, corporate spaces, trade shows, and visitor centres, with reliability and long-term stability as important as the creative experience.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/980","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=980"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":129,"date":"2023-09-05T11:20:12","date_gmt":"2023-09-05T11:20:12","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=129"},"modified":"2025-01-20T14:58:53","modified_gmt":"2025-01-20T14:58:53","slug":"in-house-support","status":"publish","type":"service","link":"https://ms-cms.com/service/in-house-support/","title":{"rendered":"In-house Support"},"template":"","class_list":["post-129","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">I collaborate individually, as the sole freelance partner, with studios and agencies on a project basis, building open partnerships to achieve shared goals. My approach is always flexible, adapting to your team’s schedule. I place a lot of importance on effective collaboration and keeping a positive, friendly attitude throughout the process.</p>\n<p class=\"p1\">This is especially efficient if you’re working with technologies like Nuxt/Vue, Next/React, Vanilla JS, and WebGL.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/129","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=129"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":128,"date":"2023-09-05T11:19:56","date_gmt":"2023-09-05T11:19:56","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=128"},"modified":"2026-08-10T09:27:29","modified_gmt":"2026-08-10T09:27:29","slug":"site-maintainance","status":"publish","type":"service","link":"https://ms-cms.com/service/site-maintainance/","title":{"rendered":"Site Maintainance"},"template":"","class_list":["post-128","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">Built around long-term relationships, not just launching and forgetting. Annual packages help keep your site running smoothly after it goes live, covering everything from updates and optimizations to security checks, protection against attacks, and new features.</p>\n<p class=\"p3\">Ongoing support, whenever it’s needed.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/128","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=128"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":127,"date":"2023-09-05T11:19:38","date_gmt":"2023-09-05T11:19:38","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=127"},"modified":"2026-08-10T09:26:49","modified_gmt":"2026-08-10T09:26:49","slug":"web3","status":"publish","type":"service","link":"https://ms-cms.com/service/web3/","title":{"rendered":"AI"},"template":"","class_list":["post-127","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">Integration of the latest AI models and APIs into digital products to create smarter and more useful experiences. From text, voice, and image generation to intelligent search and structured data extraction, with custom AI workflows tailored to each product.</p>\n<p class=\"p3\">AI agents can also automate repetitive tasks, assist teams, interact with customers, and seamlessly integrate with existing tools and business processes.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/127","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=127"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":126,"date":"2023-09-05T11:19:11","date_gmt":"2023-09-05T11:19:11","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=126"},"modified":"2026-08-10T09:27:53","modified_gmt":"2026-08-10T09:27:53","slug":"native-apps","status":"publish","type":"service","link":"https://ms-cms.com/service/native-apps/","title":{"rendered":"Web &#038; Native Apps"},"template":"","class_list":["post-126","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">Native apps developed using React Native, a framework powering thousands of apps, including familiar ones like Facebook, Skype, Outlook, and Discord. Additionally, any website can become a web app with its own icon on the home screen, thanks to Progressive Web Applications (PWA).</p>\n<p class=\"p3\">Whether you’re looking for a PWA or a fully native app, each solution is tailored to the needs of the project.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/126","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=126"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":125,"date":"2023-09-05T11:18:48","date_gmt":"2023-09-05T11:18:48","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=125"},"modified":"2026-08-10T09:28:25","modified_gmt":"2026-08-10T09:28:25","slug":"webgl","status":"publish","type":"service","link":"https://ms-cms.com/service/webgl/","title":{"rendered":"WebGL"},"template":"","class_list":["post-125","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">An innovative web experience can significantly enhance your brand’s perceived value and boost conversions. From initial concept and prototyping to implementation, every step is carefully considered to ensure your project stands out through technology and design.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/125","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=125"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":124,"date":"2023-09-05T11:18:28","date_gmt":"2023-09-05T11:18:28","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=124"},"modified":"2026-08-10T09:31:05","modified_gmt":"2026-08-10T09:31:05","slug":"shopify-e-commerce","status":"publish","type":"service","link":"https://ms-cms.com/service/shopify-e-commerce/","title":{"rendered":"E-Commerce"},"template":"","class_list":["post-124","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">A faster site, better scalability, and more conversions. When standard templates from platforms like Shopify or WooCommerce don’t deliver the experience your business needs, a custom approach can make the difference. Focused on improving loading times, enhancing usability, and, most importantly, creating a fully personalized experience for your customers.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/124","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=124"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":123,"date":"2023-09-05T11:18:10","date_gmt":"2023-09-05T11:18:10","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=123"},"modified":"2026-08-10T09:26:21","modified_gmt":"2026-08-10T09:26:21","slug":"back-end","status":"publish","type":"service","link":"https://ms-cms.com/service/back-end/","title":{"rendered":"Back-end"},"template":"","class_list":["post-123","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">Fully customizable experiences with a headless approach, selecting the best platform for each project. Everything is properly documented, allowing you and your team to work independently while saving both time and costs.</p>\n<p class=\"p1\">Experience across Strapi, Contentful, Contentstack, Prismic, Storyblok, WordPress, and Shopify.</p>\n<p class=\"p3\">Please note, back-end development is not offered as a standalone service.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/123","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=123"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":122,"date":"2023-09-05T11:17:51","date_gmt":"2023-09-05T11:17:51","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=122"},"modified":"2026-08-10T09:25:56","modified_gmt":"2026-08-10T09:25:56","slug":"front-end","status":"publish","type":"service","link":"https://ms-cms.com/service/front-end/","title":{"rendered":"Front-end"},"template":"","class_list":["post-122","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">From large-scale websites to creative campaign landing pages, bringing designs to life with precision. While rooted in technology, design is just as important. Every project is carefully implemented from the ground up, with a strong focus on motion, interaction, and user experience. The goal is to create high-performance solutions that not only work seamlessly but are also visually compelling.</p>\n<p class=\"p3\">Every detail receives meticulous attention to ensure a polished final result.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/122","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=122"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}]