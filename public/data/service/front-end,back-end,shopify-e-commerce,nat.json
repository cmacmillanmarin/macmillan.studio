[{"id":129,"date":"2023-09-05T11:20:12","date_gmt":"2023-09-05T11:20:12","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=129"},"modified":"2023-09-05T11:20:12","modified_gmt":"2023-09-05T11:20:12","slug":"in-house-support","status":"publish","type":"service","link":"https://ms-cms.com/service/in-house-support/","title":{"rendered":"In-house Support"},"template":"","acf":{"description":"<p>We collaborate individually, as freelancer, with other studios and agencies on a project basis. We aim to build open collaborations to reach mutual ambitions. Always adapted to the contractor schedule. Working one-on-one with us to build your project from the ground up.</p>\n<p>&nbsp;</p>\n<p>Specially efficient if you work with Nuxt/Vue, Next/React, Vanilla JS and WebGL.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/129"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=129"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":128,"date":"2023-09-05T11:19:56","date_gmt":"2023-09-05T11:19:56","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=128"},"modified":"2023-09-05T11:19:56","modified_gmt":"2023-09-05T11:19:56","slug":"site-maintainance","status":"publish","type":"service","link":"https://ms-cms.com/service/site-maintainance/","title":{"rendered":"Site Maintainance"},"template":"","acf":{"description":"<p>We aim to build long term relationships with our clients. We do not ship and forget. We offer year based packages to help you manage your site once it has been published. From updates, to downsides or new features. You are covered.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/128"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=128"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":126,"date":"2023-09-05T11:19:11","date_gmt":"2023-09-05T11:19:11","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=126"},"modified":"2023-09-05T11:19:11","modified_gmt":"2023-09-05T11:19:11","slug":"native-apps","status":"publish","type":"service","link":"https://ms-cms.com/service/native-apps/","title":{"rendered":"Native Apps"},"template":"","acf":{"description":"<p>We implement fully native apps using React Native.</p>\n<p>&nbsp;</p>\n<p>React Native is being used in thousands of apps, but it&#8217;s likely you&#8217;ve already used it in apps like Facebook, Skype, Outlook or Discord.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/126"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=126"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":124,"date":"2023-09-05T11:18:28","date_gmt":"2023-09-05T11:18:28","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=124"},"modified":"2023-09-05T11:34:17","modified_gmt":"2023-09-05T11:34:17","slug":"shopify-e-commerce","status":"publish","type":"service","link":"https://ms-cms.com/service/shopify-e-commerce/","title":{"rendered":"Headless E–Commerce"},"template":"","acf":{"description":"<p>A faster site, better scalability and more conversions. If a full stack solution can’t give your customer the experience your business wants, we help you. Improving loading times, increasing your SEO scores and, above all, providing a fully personalized experience to your customers.</p>\n<p>&nbsp;</p>\n<p>We work with Shopify, Square, WooCommerce, etc.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/124"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=124"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":123,"date":"2023-09-05T11:18:10","date_gmt":"2023-09-05T11:18:10","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=123"},"modified":"2023-09-05T11:18:10","modified_gmt":"2023-09-05T11:18:10","slug":"back-end","status":"publish","type":"service","link":"https://ms-cms.com/service/back-end/","title":{"rendered":"Back–end"},"template":"","acf":{"description":"<p>We offer fully customizable experiences. Always as headless solution, selecting the most appropriate platform for each project. Properly documented so you, and your team, can work independently saving costs and time.</p>\n<p>&nbsp;</p>\n<p>We work with Strapi, Contentful, Contentstack, Prismic, Storyblok, WordPress or Shopify.</p>\n<p>&nbsp;</p>\n<p>We do not offer back–end as a single service.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/123"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=123"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":122,"date":"2023-09-05T11:17:51","date_gmt":"2023-09-05T11:17:51","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=122"},"modified":"2023-09-05T11:17:51","modified_gmt":"2023-09-05T11:17:51","slug":"front-end","status":"publish","type":"service","link":"https://ms-cms.com/service/front-end/","title":{"rendered":"Front–end"},"template":"","acf":{"description":"<p>Even though we have a technological background, we care about design equally. We implement designs from scratch. With a keen interest in motion and interaction, our focus is implementing high performance experiences with great attention to detail.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/122"}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=122"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}]