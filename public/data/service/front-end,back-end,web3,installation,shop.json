[{"id":980,"date":"2026-08-08T09:30:53","date_gmt":"2026-08-08T09:30:53","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=980"},"modified":"2026-09-17T14:07:08","modified_gmt":"2026-09-17T14:07:08","slug":"installation","status":"publish","type":"service","link":"https://ms-cms.com/service/installation/","title":{"rendered":"Installations"},"template":"","class_list":["post-980","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">Interactive installations for physical spaces, combining creative technology with reliable software. From touch displays and large-scale screens to custom hardware integrations, creating experiences that extend beyond the browser.</p>\n<p class=\"p2\">Built for museums, exhibitions, corporate spaces, trade shows, and visitor centres, with the same attention to interaction, performance, and long-term reliability.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/980","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=980"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":129,"date":"2023-09-05T11:20:12","date_gmt":"2023-09-05T11:20:12","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=129"},"modified":"2026-09-17T14:08:01","modified_gmt":"2026-09-17T14:08:01","slug":"in-house-support","status":"publish","type":"service","link":"https://ms-cms.com/service/in-house-support/","title":{"rendered":"In-house Support"},"template":"","class_list":["post-129","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">Working independently with studios and agencies on a project basis, becoming a flexible extension of the team when extra development support is needed. Adapting to existing workflows and schedules, with a strong focus on clear communication and an easy collaborative process.</p>\n<p class=\"p2\">Especially effective for teams working with Nuxt/Vue, Next/React, Vanilla JS, and WebGL.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/129","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=129"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":128,"date":"2023-09-05T11:19:56","date_gmt":"2023-09-05T11:19:56","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=128"},"modified":"2026-09-17T14:08:31","modified_gmt":"2026-09-17T14:08:31","slug":"site-maintainance","status":"publish","type":"service","link":"https://ms-cms.com/service/site-maintainance/","title":{"rendered":"Site Maintainance"},"template":"","class_list":["post-128","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">Built around long-term relationships, providing ongoing support beyond launch. Annual packages cover everything from updates and optimizations to security, maintenance, and new features.</p>\n<p class=\"p2\">Flexible support whenever it’s needed.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/128","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=128"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":127,"date":"2023-09-05T11:19:38","date_gmt":"2023-09-05T11:19:38","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=127"},"modified":"2026-09-17T14:06:31","modified_gmt":"2026-09-17T14:06:31","slug":"web3","status":"publish","type":"service","link":"https://ms-cms.com/service/web3/","title":{"rendered":"AI"},"template":"","class_list":["post-127","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">Integrating the latest AI models and APIs into digital products to create smarter, more useful experiences. From text, voice, and image generation to intelligent search and structured data extraction, each integration is shaped around the needs of the product.</p>\n<p class=\"p2\">From custom AI workflows to autonomous agents, automating repetitive tasks, supporting teams, interacting with customers, and integrating with existing tools and processes.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/127","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=127"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":124,"date":"2023-09-05T11:18:28","date_gmt":"2023-09-05T11:18:28","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=124"},"modified":"2026-09-17T14:10:45","modified_gmt":"2026-09-17T14:10:45","slug":"shopify-e-commerce","status":"publish","type":"service","link":"https://ms-cms.com/service/shopify-e-commerce/","title":{"rendered":"E-Commerce"},"template":"","class_list":["post-124","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">Custom e-commerce experiences built beyond the limitations of standard templates. From Shopify and WooCommerce to headless solutions, with a focus on performance, usability, and a shopping experience shaped around the brand.</p>\n<p class=\"p2\">From storefront development to custom features and integrations, building scalable solutions around the needs of each business.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/124","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=124"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":123,"date":"2023-09-05T11:18:10","date_gmt":"2023-09-05T11:18:10","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=123"},"modified":"2026-09-17T14:17:45","modified_gmt":"2026-09-17T14:17:45","slug":"back-end","status":"publish","type":"service","link":"https://ms-cms.com/service/back-end/","title":{"rendered":"Back-end"},"template":"","class_list":["post-123","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">Fully customizable experiences built with a headless approach, choosing the right platform for each project. Every implementation is structured and documented to make content management simple and give teams the independence to work efficiently.</p>\n<p class=\"p1\">Experience across platforms including Strapi, Sanity, Contentful, Contentstack, Prismic, Storyblok, WordPress, and Shopify.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/123","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=123"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":122,"date":"2023-09-05T11:17:51","date_gmt":"2023-09-05T11:17:51","guid":{"rendered":"https://ms-cms.com/?post_type=service&#038;p=122"},"modified":"2026-09-17T14:04:32","modified_gmt":"2026-09-17T14:04:32","slug":"front-end","status":"publish","type":"service","link":"https://ms-cms.com/service/front-end/","title":{"rendered":"Front-end"},"template":"","class_list":["post-122","service","type-service","status-publish","hentry"],"acf":{"description":"<p class=\"p1\">From large-scale websites to creative campaign landing pages, bringing designs to life with precision. Rooted in technology but with an equal focus on design, every project is built from the ground up with careful attention to motion, interaction, and user experience.</p>\n<p class=\"p2\">The result is high-performance digital experiences that work seamlessly, feel considered, and are visually compelling.</p>\n"},"_links":{"self":[{"href":"https://ms-cms.com/wp-json/wp/v2/service/122","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ms-cms.com/wp-json/wp/v2/service"}],"about":[{"href":"https://ms-cms.com/wp-json/wp/v2/types/service"}],"wp:attachment":[{"href":"https://ms-cms.com/wp-json/wp/v2/media?parent=122"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}]